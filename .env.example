# ====================================================================
# GOLD & SILVER RATE PLATFORM - ENVIRONMENT VARIABLES
# ====================================================================

# 1. Supabase Public Config (Safe for browser / Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 2. Market Data API (Optional - for direct client live feed fallback)
# Leave empty to use free public bullion feeds or Supabase Edge Function
VITE_GOLD_API_KEY=

# 3. Server-Only Secrets (Used ONLY in Supabase Edge Functions / Backend)
# DO NOT put these in VITE_ variables! Configure in Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# TWILIO_ACCOUNT_SID=your-twilio-sid (if using Twilio for SMS OTP)
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_MESSAGE_SERVICE_SID=your-service-sid
